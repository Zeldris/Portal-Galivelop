#!/bin/bash
# Traído de Tarkor (QA-13): no se sube nada que no tipa o no pasa los tests, y a `main` (que es la web publicada)
# no llega código sin revisar. Lo activa `.claude/hooks/session-start.sh` (core.hooksPath); a mano:
# `git config core.hooksPath .githooks`. Saltarlo solo para un `WIP:` con tests en rojo: `git push --no-verify`.
set -uo pipefail
raiz="$(git rev-parse --show-toplevel)"
cd "$raiz" || exit 1
cero=0000000000000000000000000000000000000000
mapfile -t refs                                 # las refs, antes de lanzar nada que pueda leer la entrada
comprobado=""
for linea in "${refs[@]}"; do
  read -r ref_local sha_local ref_remota sha_remota <<< "$linea"
  [ "$sha_local" = "$cero" ] && continue          # borrar una rama
  case "$ref_local" in refs/tags/*) continue ;; esac
  # Se comprueba el commit que se sube, no la carpeta de trabajo.
  if [ "$comprobado" != "$sha_local" ]; then
    echo "pre-push: npm run check de ${sha_local:0:7}…"
    if [ "$sha_local" = "$(git rev-parse HEAD)" ] && [ -z "$(git status --porcelain)" ]; then
      dir="$raiz"
    else
      dir="$(mktemp -d)"
      git worktree add -q --detach "$dir" "$sha_local" || { rmdir "$dir"; echo "pre-push: no pude preparar el commit ${sha_local:0:7}"; exit 1; }
      ln -s "$raiz/node_modules" "$dir/node_modules"
    fi
    (cd "$dir" && npm run --silent check > /tmp/pre-push-check.log 2>&1 < /dev/null)
    ok=$?
    [ "$dir" != "$raiz" ] && git worktree remove --force "$dir"
    if [ $ok -ne 0 ]; then
      grep -E "error|FAIL|✗|Expected|Received" /tmp/pre-push-check.log | head -30 || true
      echo "pre-push: en rojo (detalle en /tmp/pre-push-check.log)"
      exit 1
    fi
    comprobado="$sha_local"
  fi
  # A main: el código que trae tiene que estar revisado. Vale la marca de docs/registros/revisado.txt (en el commit
  # que se sube) si es antecesora y desde ella solo ha cambiado contenido.
  if [ "$ref_remota" = "refs/heads/main" ]; then
    base=""
    if [ "$sha_remota" != "$cero" ]; then
      git cat-file -e "$sha_remota" 2>/dev/null || git fetch -q origin main
      git cat-file -e "$sha_remota" 2>/dev/null || { echo "pre-push: no tengo el main remoto (${sha_remota:0:7}); git fetch origin main"; exit 1; }
      base="$sha_remota"
    fi
    codigo="$(bash tools/qa/es-codigo.sh "$base" "$sha_local")"
    if [ -n "$codigo" ]; then
      marca="$(git show "$sha_local:docs/registros/revisado.txt" 2>/dev/null | tr -d '[:space:]')"
      if [ -z "$marca" ] || ! git merge-base --is-ancestor "$marca" "$sha_local" 2>/dev/null \
         || [ -n "$(bash tools/qa/es-codigo.sh "$marca" "$sha_local")" ]; then
        echo "pre-push: esta subida a main trae código sin revisar:"; echo "$codigo" | head -10 | sed 's/^/  /'
        echo "Antes: /code-review del diff contra origin/main, arreglos subidos y bash tools/qa/revisado.sh (CLAUDE.md)."
        exit 1
      fi
    fi
  fi
done
echo "pre-push: todo en verde."
