#!/bin/bash
# Traído de Tarkor (QA-13): no se sube nada que no tipa o no pasa los tests. Lo activa
# `.claude/hooks/session-start.sh` (core.hooksPath). La web se publica desde `main`, así que esto también protege
# la publicación. Saltarlo solo para un `WIP:` con tests en rojo: `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: npm run check (tsc y tests)…"
npm run --silent check > /tmp/pre-push-check.log 2>&1 || {
  grep -E "error|FAIL|✗|Expected|Received" /tmp/pre-push-check.log | head -30
  echo "pre-push: en rojo (detalle en /tmp/pre-push-check.log)"
  exit 1
}
echo "pre-push: todo en verde."
